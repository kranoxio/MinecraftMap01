# Kopiere diese Datei zu "bot.env" und trage deine Werte ein.
# bot.env NIEMALS auf GitHub hochladen oder mit jemandem teilen!

# Token des NEUEN Bots "Bern Whitelist" (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Server-ID (Rechtsklick auf den Discord-Servernamen -> Server-ID kopieren)
GUILD_ID=

# Rollen-ID von "⛏️ Spieler"
SPIELER_ROLE_ID=

# Kanal-ID von #allgemein – dort erscheint der Knopf, falls jemand Privatnachrichten gesperrt hat
FALLBACK_CHANNEL_ID=

# Kanal-ID von #ledger-und-bans – dort protokolliert der Bot jede Änderung (leer = aus)
LOG_CHANNEL_ID=

# Lokale IP des NAS und RCON-Port/Passwort aus der server.properties
RCON_HOST=192.168.1.111
RCON_PORT=25575
RCON_PASSWORD=

# Wird den Spielern nach dem Eintragen angezeigt
SERVER_ADDRESS=mc.deinedomain.ch
